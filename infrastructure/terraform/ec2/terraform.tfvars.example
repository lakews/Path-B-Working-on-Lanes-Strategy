# APEX TRADER - EC2 Terraform Variables
# Copy this file to terraform.tfvars and fill in your values

# AWS Configuration
aws_region   = "us-east-1"
environment  = "production"

# EC2 Instance
instance_type = "t3.medium"  # 2 vCPU, 4GB RAM (~$30/month)
key_name      = "your-ssh-key-name"  # Create in AWS Console first

# MongoDB Atlas (Get from Atlas dashboard)
mongodb_uri = "mongodb+srv://username:password@cluster.mongodb.net/apex_trader?retryWrites=true&w=majority"

# Polymarket API Credentials (Get from Polymarket)
polymarket_api_key        = "your-api-key"
polymarket_api_secret     = "your-api-secret"
polymarket_api_passphrase = "your-passphrase"

# Wallet (KEEP THIS SECURE!)
wallet_private_key = "your-wallet-private-key"

# Optional: SendGrid for email alerts
sendgrid_api_key = ""
alert_email      = "your@email.com"

# Optional: Custom domain
domain_name = ""
