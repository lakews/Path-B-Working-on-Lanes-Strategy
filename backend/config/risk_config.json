{
  "_metadata": {
    "version": "1.1.0",
    "description": "SSOT Risk Configuration for 5-Lane Trading Architecture",
    "last_updated": "2026-02-15T00:00:00Z",
    "spec_reference": "/app/docs/5_LANE_ARCHITECTURE.md"
  },
  
  "global": {
    "max_drawdown_pct": 0.05,
    "max_deployment_pct": 0.80,
    "cash_buffer_pct": 0.05,
    "kill_switch_low": 0.03,
    "kill_switch_high": 0.97,
    "min_trade_amount": 2.0,
    "min_bet_floor": 5.0,
    "taker_fee": 0.02,
    "maker_fee": 0.00,
    "max_open_positions": 50,
    "price_zone_threshold": 0.10
  },
  
  "extreme_price_validation": {
    "enabled": true,
    "description": "Tiered validation for extreme prices instead of blanket kill switch",
    "extreme_low_threshold": 0.03,
    "extreme_high_threshold": 0.97,
    "requirements": {
      "min_orderbook_depth_usd": 100,
      "min_spread_quality": 0.05,
      "min_recent_volume_1h": 50,
      "min_time_to_expiry_hours": 24
    },
    "strategy_overrides": {
      "hft_volatility_exploit": {
        "enabled": true,
        "kill_switch_low": 0.005,
        "kill_switch_high": 0.995,
        "description": "Volatility exploit needs access to extreme prices for convexity"
      },
      "gamma_scalp": {
        "enabled": true,
        "kill_switch_low": 0.01,
        "kill_switch_high": 0.99,
        "description": "Gamma scalp targets OTM options for convexity"
      }
    }
  },
  
  "lanes": {
    "HFT": {
      "name": "Market Maker",
      "description": "High-frequency, low-latency market making. Never blocks for slow operations.",
      "alloc_pct": 0.35,
      "max_pos_usd": 50.0,
      "max_pos_pct": 0.02,
      "cycle_seconds": 0.5,
      "min_liquidity": 10000.0,
      "min_volume_24h": 5000.0,
      "max_spread_pct": 0.12,
      "sizing_method": "fixed_unit",
      "strategies": ["hft_scalp", "hft_maker", "delta_neutral"]
    },
    "ALPHA": {
      "name": "Strategist",
      "description": "Slower, conviction-driven directional trading based on deep analysis.",
      "alloc_pct": 0.55,
      "max_pos_usd": 100.0,
      "max_pos_pct": 0.03,
      "cycle_seconds": 30.0,
      "min_liquidity_core": 1000.0,
      "min_liquidity_whale": 500.0,
      "min_volume_core": 1000.0,
      "min_volume_whale": 500.0,
      "max_spread_pct": 0.05,
      "sizing_method": "binary_kelly",
      "strategies": ["alpha_directional", "arbitrage"]
    },
    "GAMMA": {
      "name": "Sniper",
      "description": "Opportunistic convexity hunting in low-liquidity, OTM markets.",
      "alloc_pct": 0.10,
      "max_pos_usd": 15.0,
      "max_pos_pct": 0.01,
      "cycle_seconds": 30.0,
      "min_liquidity": 250.0,
      "min_volume_24h": 250.0,
      "max_spread_cents": 0.03,
      "whale_price_ceiling": 0.10,
      "sizing_method": "fixed_unit",
      "strategies": ["gamma_scalp"]
    },
    "SPORTS": {
      "name": "Bookie",
      "description": "Isolated lane for sports arbitrage against real bookmaker odds.",
      "alloc_pct": 0.15,
      "is_overlay": true,
      "max_pos_usd": 100.0,
      "max_pos_pct": 0.03,
      "cycle_seconds": 30.0,
      "min_liquidity": 250.0,
      "min_volume_24h": 250.0,
      "max_spread_pct": 0.15,
      "min_edge": 0.02,
      "allow_no_bets": true,
      "sizing_method": "sports_kelly",
      "strategies": ["sports_arbitrage"]
    },
    "NEWS": {
      "name": "Injector",
      "description": "Bridge between slow LLM analysis and fast HFT execution.",
      "alloc_pct": 0.05,
      "is_overlay": true,
      "max_pos_usd": 100.0,
      "max_pos_pct": 0.05,
      "min_bayes_factor": 3.0,
      "strong_bayes_factor": 10.0,
      "default_ttl_seconds": 300,
      "resolution_ttl_seconds": 3600,
      "max_injections_per_minute": 20,
      "sizing_method": "news_kelly",
      "strategies": ["news_sniper"]
    }
  },
  
  "kelly": {
    "scaling_factor": 0.25,
    "min_fraction": 0.10,
    "max_fraction": 0.50,
    "utilization_exponent": 1.5,
    "utilization_hard_stop": 0.95,
    "edge_retention_pct": 0.20,
    "time_penalty_max_days": 90,
    "time_penalty_floor": 0.50
  },
  
  "exit_strategies": {
    "hft_scalp": {
      "type": "mechanical",
      "tp_pct": 0.015,
      "sl_pct": 0.015,
      "max_hours": 4
    },
    "hft_maker": {
      "type": "mechanical",
      "tp_pct": 0.015,
      "sl_pct": 0.015,
      "max_hours": 4
    },
    "delta_neutral": {
      "type": "mechanical",
      "tp_pct": 0.015,
      "sl_pct": 0.015,
      "max_hours": 4
    },
    "alpha_directional": {
      "type": "complex",
      "base_tp_pct": 0.30,
      "base_sl_pct": 0.15,
      "base_max_hours": 72,
      "use_asset_modifiers": true
    },
    "arbitrage": {
      "type": "mechanical",
      "tp_pct": 0.02,
      "sl_pct": 0.02,
      "max_hours": 6
    },
    "gamma_scalp": {
      "type": "whale",
      "stop_multiple": 0.50,
      "free_roll_multiple": 2.0,
      "free_roll_sell_pct": 0.50,
      "moonbag_multiple": 5.0,
      "max_hours": 168
    },
    "sports_arbitrage": {
      "type": "mechanical",
      "tp_pct": 0.30,
      "sl_pct": 0.25,
      "max_hours": 48
    },
    "news_sniper": {
      "type": "ttl_based",
      "default_ttl_seconds": 300,
      "resolution_ttl_seconds": 3600
    }
  },
  
